04200093 // Instr 0:  addi x1, x0, 0x42        (x1 = 0x42, Data Memory verification value)
00102823 // Instr 1:  sw   x1, 16(x0)         (mem[0x10] = 0x42, AXI Store to Data Memory)
01002103 // Instr 2:  lw   x2, 16(x0)         (x2 = mem[0x10], AXI Load from Data Memory)
50000337 // Instr 3:  lui  x6, 0x50000        (x6 = 0x5000_0000, Framebuffer Base Address)
000FF3B7 // Instr 4:  lui  x7, 0x000FF        (x7 = 0x000FF000)
00439393 // Instr 5:  slli x7, x7, 4          (x7 = 0x00FF_0000, Pure Red color pixel)
00732023 // Instr 6:  sw   x7, 0(x6)          (mem[0x5000_0000] = Red, Scanline 0 Pixel 0)
0083D413 // Instr 7:  srli x8, x7, 8          (x8 = 0x0000_FF00, Pure Green color pixel)
10832023 // Instr 8:  sw   x8, 256(x6)        (mem[0x5000_0100] = Green, Scanline 0 Pixel 64)
00845493 // Instr 9:  srli x9, x8, 8          (x9 = 0x0000_00FF, Pure Blue color pixel)
20932023 // Instr 10: sw   x9, 512(x6)        (mem[0x5000_0200] = Blue, Scanline 0 Pixel 128)
0083E533 // Instr 11: or   x10, x7, x8        (x10 = 0x00FF_FF00, Yellow intermediate)
00956533 // Instr 12: or   x10, x10, x9       (x10 = 0x00FF_FFFF, Pure White color pixel)
30A32023 // Instr 13: sw   x10, 768(x6)       (mem[0x5000_0300] = White, Scanline 0 Pixel 192)
50030593 // Instr 14: addi x11, x6, 1280      (x11 = 0x5000_0500, intermediate address)
5075A023 // Instr 15: sw   x7, 1280(x11)      (mem[0x5000_0A00] = Red, Scanline 1 Pixel 0)
100001B7 // Instr 16: lui  x3, 0x10000        (x3 = 0x1000_0000, VGA_CTRL MMIO address)
00100293 // Instr 17: addi x5, x0, 1          (x5 = 1, display_enable)
0051A023 // Instr 18: sw   x5, 0(x3)          (mem[0x1000_0000] = 1, enables VGA display via AXI)
00000063 // Instr 19: beq  x0, x0, 0          (infinite loop halt at PC = 0x4C)
